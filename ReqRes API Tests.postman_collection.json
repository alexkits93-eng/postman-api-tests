    {
      "name": "Users",
      "item": [
        {
          "name": "GET - Get Users List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is less than 1000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Content-Type is application/json\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "const response = pm.response.json();\r",
                  "pm.test(\"Current page is 2\", function () {\r",
                  "    pm.expect(response.page).to.eql(2);\r",
                  "});\r",
                  "pm.test(\"Users count equals 6\", function () {\r",
                  "    pm.expect(response.data.length).to.eql(6);\r",
                  "});\r",
                  "pm.test(\"User has required fields\", function () {\r",
                  "    pm.expect(response.data[0]).to.have.property(\"id\");\r",
                  "    pm.expect(response.data[0]).to.have.property(\"email\");\r",
                  "    pm.expect(response.data[0]).to.have.property(\"first_name\");\r",
                  "    pm.expect(response.data[0]).to.have.property(\"last_name\");\r",
                  "    pm.expect(response.data[0]).to.have.property(\"avatar\");\r",
                  "});\r",
                  "pm.test(\"Every user has required fields\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user).to.have.property(\"id\");\r",
                  "        pm.expect(user).to.have.property(\"email\");\r",
                  "        pm.expect(user).to.have.property(\"first_name\");\r",
                  "        pm.expect(user).to.have.property(\"last_name\");\r",
                  "        pm.expect(user).to.have.property(\"avatar\");\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "pm.test(\"User fields have correct data types\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.id).to.be.a(\"number\");\r",
                  "        pm.expect(user.email).to.be.a(\"string\");\r",
                  "        pm.expect(user.first_name).to.be.a(\"string\");\r",
                  "        pm.expect(user.last_name).to.be.a(\"string\");\r",
                  "        pm.expect(user.avatar).to.be.a(\"string\");\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "pm.test(\"Emails contain @ symbol\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.email).to.include(\"@\");\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Avatar URL starts with https\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.avatar.startsWith(\"https://\")).to.be.true;\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All user IDs are unique\", function () {\r",
                  "\r",
                  "    const ids = response.data.map(user => user.id);\r",
                  "    const uniqueIds = new Set(ids);\r",
                  "\r",
                  "    pm.expect(uniqueIds.size).to.eql(ids.length);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User first name is not empty\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.first_name).to.not.be.empty;\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User last name is not empty\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.last_name).to.not.be.empty;\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "pm.test(\"User email has correct format\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User ID is positive\", function () {\r",
                  "    response.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user.id).to.be.above(0);\r",
                  "\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains total users count\", function () {\r",
                  "    pm.expect(response).to.have.property(\"total\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains total pages count\", function () {\r",
                  "    pm.expect(response).to.have.property(\"total_pages\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Page number does not exceed total pages\", function () {\r",
                  "    pm.expect(response.page).to.be.at.most(response.total_pages);\r",
                  "\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
