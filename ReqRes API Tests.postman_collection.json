    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST - Login Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response contains token\", function () {\r",
                  "    pm.expect(response).to.have.property(\"token\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token is not empty\", function () {\r",
                  "    pm.expect(response.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token is a string\", function () {\r",
                  "    pm.expect(response.token).to.be.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is less than 1000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", response.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n\"email\": \"eve.holt@reqres.in\",\r\n\"password\": \"pistol\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Authenticates a registered user.  \n  \nMethod:  \nPOST  \n  \nEndpoint:  \n/api/login  \n  \nRequest Body:  \n{  \n\"email\": \"eve.holt@reqres.in\",  \n\"password\": \"cityslicka\"  \n}  \n  \nExpected Result:  \n200 OK  \n  \nTests:  \n\\- Status code  \n\\- Response contains token  \n\\- Token is not empty  \n\\- Token data type validation  \n\\- Response time  \n\\- Save token to environment variable"
          },
          "response": []
        },
